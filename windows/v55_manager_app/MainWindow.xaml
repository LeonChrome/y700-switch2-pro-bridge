<Window x:Class="Y700Switch2V55Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRO2 手柄无线接收器控制板"
        Width="1460" Height="920" MinWidth="1240" MinHeight="780"
        Background="#F3F6FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="PanelFill" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#D9E2EC"/>
        <SolidColorBrush x:Key="SoftFill" Color="#F8FAFC"/>
        <LinearGradientBrush x:Key="HeroFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#14253F" Offset="0.52"/>
            <GradientStop Color="#1E293B" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
        </Style>

        <Style x:Key="RoseButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E11D48"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E11D48"/>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>

        <Style x:Key="ModeDeckButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="18"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="CardShadow"
                                                  Color="#26000000"
                                                  BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Opacity="0.16"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="28" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="20" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.96"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.54"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource HeroFill}"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="24,20,24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E0F2FE" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="15" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock Text="V5.9" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#172554" BorderBrush="#60A5FA" BorderThickness="1" CornerRadius="15" Padding="10,4">
                            <TextBlock Text="V5.9 震动保真版" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="PRO2 手柄无线接收器控制板"
                               Foreground="#F8FAFC"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,12,0,6"/>
                    <TextBlock Text="统一控制 Pro2 / Nintendo、Xbox / XInput、DualSense-like 三种模式。这一版重点强化震动保真、模式互锁和更完整的前端体验。"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               TextWrapping="Wrap"
                               MaxWidth="760"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Border Background="{Binding UsbIndicatorBrush}" CornerRadius="18" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding UsbLightText}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{Binding BleDisplayBackgroundBrush}" BorderBrush="{Binding BleDisplayBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding BleDisplayBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BleDisplayText}" Foreground="{Binding BleDisplayForegroundBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{Binding OverallStatusBackgroundBrush}" CornerRadius="18" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding OverallBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding OverallStatus}" Foreground="{Binding OverallStatusForegroundBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="连接与检测"/>
                            <ComboBox Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding Ports}"
                                      SelectedItem="{Binding SelectedPort}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,10"/>
                            <WrapPanel Margin="-4,0,0,0">
                                <Button Style="{StaticResource SubtleButton}" Content="刷新串口" Command="{Binding RefreshPortsCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="USB 检查" Command="{Binding CheckUsbCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="音频列表" Command="{Binding ListAudioCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding PortStatus}" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding UsbStatus}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding AudioStatus}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="BLE Pro2"/>
                            <WrapPanel Margin="-4,0,0,0">
                                <Button Style="{StaticResource SubtleButton}" Content="扫描" Command="{Binding BleScanCommand}" IsEnabled="{Binding CanUseBleButtons}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="列表" Command="{Binding BleListCommand}" IsEnabled="{Binding CanUseBleButtons}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="重连上次" Command="{Binding BleReconnectCommand}" IsEnabled="{Binding CanUseBleButtons}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="自动开" Command="{Binding BleAutoOnCommand}" IsEnabled="{Binding CanUseBleButtons}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="自动关" Command="{Binding BleAutoOffCommand}" IsEnabled="{Binding CanUseBleButtons}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="断开" Command="{Binding BleDisconnectCommand}" IsEnabled="{Binding CanUseBleButtons}"/>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource MetricLabel}" Text="目标过滤 / 地址 / 关键词" Margin="0,12,0,4"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding BleTarget, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="可输入地址、序号或名称关键词。留空则使用上一次目标。"/>
                            <WrapPanel Margin="-4,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="连接目标" Command="{Binding BleConnectCommand}" IsEnabled="{Binding CanUseBleButtons}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="重置摇杆中心" Command="{Binding InputRecalibrateCommand}" IsEnabled="{Binding CanUseBleButtons}"/>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource MetricLabel}" Text="可选扫描结果" Margin="0,12,0,4"/>
                            <ComboBox Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding BleDevices}"
                                      SelectedItem="{Binding SelectedBleDevice}"
                                      DisplayMemberPath="DisplayName"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding BleStatus}" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding BleCandidates}" Margin="0,6,0,0" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="快捷工具"/>
                            <WrapPanel Margin="-4,0,0,0">
                                <Button Style="{StaticResource SubtleButton}" Content="joy.cpl" Command="{Binding OpenJoyCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="设备管理器" Command="{Binding OpenDeviceManagerCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="HID 恢复固件" Command="{Binding FlashHidOnlyCommand}" IsEnabled="{Binding CanSwitchModes}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="下一步动作" Margin="0,12,0,4"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding NextAction}"/>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="内置包" Margin="0,12,0,4"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding FirmwareSummary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="三模切换台"/>
                                <TextBlock Style="{StaticResource HintText}" Text="点击手柄卡片即可切换模式。悬停会显示切换意图，刷写后管理器会等待 USB 重新枚举并检查结果。"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource MetricLabel}" Text="当前 USB 模式"/>
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CurrentModeLabel}" HorizontalAlignment="Right"/>
                                <TextBlock Style="{StaticResource MetricLabel}" Text="目标模式" Margin="0,10,0,0"/>
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding DesiredModeLabel}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource ModeDeckButton}"
                                    Background="{Binding DualSenseCardBackground}"
                                    BorderBrush="{Binding DualSenseCardBorderBrush}"
                                    Command="{Binding ActivateDualSenseModeCommand}"
                                    IsEnabled="{Binding CanSwitchModes}"
                                    AutomationProperties.AutomationId="ModeCardDualSense"
                                    AutomationProperties.Name="切换到 DualSense-like"
                                    ToolTip="{Binding DualSenseCardTooltip}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DualSense-like" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <Border Grid.Column="1" Background="{Binding DualSenseCardBadgeBrush}" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{Binding DualSenseCardStateText}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="10" Height="170">
                                        <Image Source="assets/photos/dualsense.jpg" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Margin="0,14,0,0"
                                               Text="蓝白路线。适合在 PC 上走 DualSense-like 识别，也能保留控制器音频实验链路，是普通震动与兼容性测试的重要入口。"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource ModeDeckButton}"
                                    Background="{Binding Pro2CardBackground}"
                                    BorderBrush="{Binding Pro2CardBorderBrush}"
                                    Command="{Binding ActivatePro2ModeCommand}"
                                    IsEnabled="{Binding CanSwitchModes}"
                                    AutomationProperties.AutomationId="ModeCardPro2"
                                    AutomationProperties.Name="切换到 Pro2 / Nintendo"
                                    ToolTip="{Binding Pro2CardTooltip}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pro2 / Nintendo" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <Border Grid.Column="1" Background="{Binding Pro2CardBadgeBrush}" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{Binding Pro2CardStateText}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="10" Height="170">
                                        <Image Source="assets/photos/switch2_pro_controller_front.jpg" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Margin="0,14,0,0"
                                               Text="红白路线。最适合稳定输入、原始 HID 0x02 震动以及 BLE Pro2 调试，也是当前最实用的日常模式。"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    Style="{StaticResource ModeDeckButton}"
                                    Background="{Binding XboxCardBackground}"
                                    BorderBrush="{Binding XboxCardBorderBrush}"
                                    Command="{Binding ActivateXboxModeCommand}"
                                    IsEnabled="{Binding CanSwitchModes}"
                                    AutomationProperties.AutomationId="ModeCardXbox"
                                    AutomationProperties.Name="切换到 Xbox / XInput"
                                    ToolTip="{Binding XboxCardTooltip}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Xbox" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <Border Grid.Column="1" Background="{Binding XboxCardBadgeBrush}" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{Binding XboxCardStateText}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="10" Height="170">
                                        <Image Source="assets/photos/xbox_controller_black.png" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Margin="0,14,0,0"
                                               Text="绿色路线。USB 枚举为 Xbox 360 / XInput，适合 Apex、Steam 和只认 XInput 的普通震动游戏。"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="目标模式概览"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding DesiredModeLabel}"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding DesiredModeDescription}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="切换提示"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding ModeDeckHint}"/>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="切换诊断" Margin="0,12,0,4"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding ModeSwitchStatus}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Panel}" Visibility="{Binding Pro2LabVisibility}">
                            <StackPanel IsEnabled="{Binding CanUsePro2ToolButtons}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Pro2 原始震动台"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding Pro2ToolStateText}" Margin="0,0,0,10"/>

                                <WrapPanel Margin="-4,0,0,0">
                                    <Button Style="{StaticResource SubtleButton}" Content="读取状态" Command="{Binding Pro2RumbleStatusCommand}"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="轻震自检" Command="{Binding Pro2RumbleLightCommand}"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="重震自检" Command="{Binding Pro2RumbleStrongCommand}"/>
                                    <Button Style="{StaticResource RoseButton}" Content="停止" Command="{Binding Pro2RumbleStopCommand}"/>
                                </WrapPanel>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}" Text="{Binding Pro2RumbleScale}" Margin="0,0,6,0" ToolTip="scale_percent 10..250"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding Pro2RumbleHoldMs}" Margin="0,0,6,0" ToolTip="hold_ms 50..1000"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource InputBox}" Text="{Binding Pro2RumbleTickMs}" Margin="0,0,6,0" ToolTip="tick_ms 5..50"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource InputBox}" Text="{Binding Pro2RumbleStopPackets}" Margin="0,0,6,0" ToolTip="stop_packets 1..8"/>
                                    <Button Grid.Column="4" Style="{StaticResource SubtleButton}" Content="应用参数" Command="{Binding Pro2RumbleApplyTuneCommand}"/>
                                    <Button Grid.Column="5" Style="{StaticResource PrimaryButton}" Content="手动脉冲" Command="{Binding Pro2RumbleManualHoldCommand}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource HintText}" Text="{Binding Pro2RumbleStatus}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Visibility="{Binding DualSenseLabVisibility}">
                            <StackPanel IsEnabled="{Binding CanUseDualSenseToolButtons}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="DualSense 实验台"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding DualSenseToolStateText}" Margin="0,0,0,10"/>

                                <WrapPanel Margin="-4,0,0,0">
                                    <Button Style="{StaticResource SubtleButton}" Content="状态" Command="{Binding HapticStatusCommand}"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="开启试运行" Command="{Binding DryRunOnCommand}"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="关闭实时转发" Command="{Binding LiveOffCommand}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="开启实时转发" Command="{Binding LiveOnCommand}"/>
                                </WrapPanel>

                                <WrapPanel Margin="-4,4,0,0">
                                    <Button Style="{StaticResource SubtleButton}" Content="轻击" Command="{Binding HapticTickCommand}"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="重击" Command="{Binding HapticPunchCommand}"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="停止" Command="{Binding HapticStopCommand}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="安全实体测试" Command="{Binding SafeHapticTestCommand}"/>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource MetricLabel}" Text="音频解析器" Margin="0,12,0,4"/>
                                <WrapPanel Margin="-4,0,0,0">
                                    <Button Style="{StaticResource SubtleButton}" Content="后声道对" Command="{Binding AudioParserRearCommand}"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="前声道对" Command="{Binding AudioParserFrontCommand}"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="最强通道" Command="{Binding AudioParserStrongestCommand}"/>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource HintText}" Text="{Binding HapticStatus}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Visibility="{Binding DualSenseLabDisabledVisibility}">
                            <StackPanel IsEnabled="{Binding CanUseXboxToolButtons}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="DualSense 实验台"/>
                                <TextBlock Style="{StaticResource HintText}" Text="当前并不处于 DualSense-like 模式，因此这些按钮会收起，避免误触发错误模式下的专属操作。"/>
                                <TextBlock Style="{StaticResource HintText}" Text="如果要继续测试音频、震动或游戏监听，请先点击上方的 DualSense-like 卡片切换。" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Visibility="{Binding XboxLabVisibility}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Xbox / XInput 实验台"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding XboxToolStateText}" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}" Text="{Binding XInputProbeSeconds}" Margin="0,0,6,0" ToolTip="持续秒数 5..180"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding XInputProbeLow}" Margin="0,0,6,0" ToolTip="左马达 0..65535"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource InputBox}" Text="{Binding XInputProbeHigh}" Margin="0,0,6,0" ToolTip="右马达 0..65535"/>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="运行主机侧 XInput 识别与双马达普通震动探针，并写出日志。"/>
                                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="运行探针" Command="{Binding RunXInputProbeCommand}" IsEnabled="{Binding CanUseXboxToolButtons}" AutomationProperties.AutomationId="RunXInputProbeButton"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="当前状态"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding XboxStatus}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="说明"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="这条线路会验证 Windows / Steam / 游戏是否按 XInput 路径认设备，并观察普通震动是否通过 ESP32 回传到 Pro2。"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="游戏监听 / 音频探针"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="先确认上游应用是否真的打开了 Wireless Controller Audio。探针阶段先看链路，不急着追求手感。"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Style="{StaticResource InputBox}" Width="74" Text="{Binding GameMonitorSeconds}" ToolTip="10..900"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="开始监听" Command="{Binding StartGameMonitorCommand}" IsEnabled="{Binding CanStartMonitorButton}"/>
                                        <Button Style="{StaticResource RoseButton}" Content="停止监听" Command="{Binding StopGameMonitorCommand}" IsEnabled="{Binding CanStopMonitorButton}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding MonitorStatus}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="PCM / 图样自测"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource FieldCombo}" ItemsSource="{Binding AudioPatterns}" SelectedItem="{Binding AudioPattern}" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding AudioIntensity}" Margin="0,0,6,0" ToolTip="0..100"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource InputBox}" Text="{Binding AudioDurationMs}" Margin="0,0,6,0" ToolTip="毫秒"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource InputBox}" Text="{Binding AudioDeviceName}" Margin="0,0,6,0" ToolTip="音频端点名称片段"/>
                                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="发送" Command="{Binding SendAudioPatternCommand}" IsEnabled="{Binding CanUseAudioPatternButton}" AutomationProperties.AutomationId="SendAudioPatternButton"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="raw02 安全状态"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding SafetySummary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="建议下一步"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding NextAction}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="日志"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource InputBox}"
                                     Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="12,0,10,0"
                                     ToolTip="串口命令，例如 status / haptic status / ble list"/>
                            <WrapPanel Grid.Column="2">
                                <Button Style="{StaticResource SubtleButton}" Content="发送" Command="{Binding SendCustomCommand}" IsEnabled="{Binding CanSendCustomSerialCommand}" AutomationProperties.AutomationId="SendCustomCommandButton"/>
                                <Button Style="{StaticResource SubtleButton}" Content="清空" Command="{Binding ClearLogCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="保存" Command="{Binding SaveLogCommand}"/>
                            </WrapPanel>
                        </Grid>

                        <TextBox x:Name="LogBox"
                                 Grid.Row="1"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 TextChanged="LogBox_TextChanged"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#0B1220"
                                 Foreground="#DBE7F3"
                                 BorderThickness="0"
                                 Padding="12"/>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
