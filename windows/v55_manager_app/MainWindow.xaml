<Window x:Class="Y700Switch2V55Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Y700 Switch2 V5.5 Manager"
        Width="1320" Height="840" MinWidth="1160" MinHeight="720"
        Background="#EEF2F3"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#17212B"/>
        <SolidColorBrush x:Key="Muted" Color="#667085"/>
        <SolidColorBrush x:Key="PanelLine" Color="#D9E1E7"/>
        <SolidColorBrush x:Key="PanelFill" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SoftFill" Color="#F7FAFC"/>
        <SolidColorBrush x:Key="Accent" Color="#0F766E"/>
        <SolidColorBrush x:Key="Accent2" Color="#E11D48"/>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#CAD4DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F6F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E7EEF2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <Style x:Key="RoseButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource Accent2}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent2}"/>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#CAD4DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D8E1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="#D9E1E7" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8" Background="#17212B" VerticalAlignment="Center">
                    <TextBlock Text="V5.5" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Y700 Switch2 Manager" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="DualSense haptic audio / Pro2 raw02 / BLE bridge diagnostics" Foreground="{StaticResource Muted}" FontSize="13"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CAD4DD" BorderThickness="1" CornerRadius="16" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding OverallBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding OverallStatus}" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="连接"/>
                            <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" DisplayMemberPath="DisplayName" Margin="0,0,0,8" Padding="8,6"/>
                            <WrapPanel>
                                <Button Style="{StaticResource SubtleButton}" Content="刷新端口" Command="{Binding RefreshPortsCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="USB 检查" Command="{Binding CheckUsbCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="音频列表" Command="{Binding ListAudioCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding PortStatus}" Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding UsbStatus}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding AudioStatus}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="BLE Pro2"/>
                            <WrapPanel>
                                <Button Style="{StaticResource SubtleButton}" Content="扫描" Command="{Binding BleScanCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="列表" Command="{Binding BleListCommand}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="连上次" Command="{Binding BleReconnectCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="自动开" Command="{Binding BleAutoOnCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="自动关" Command="{Binding BleAutoOffCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="断开" Command="{Binding BleDisconnectCommand}"/>
                            </WrapPanel>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding BleTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,4" ToolTip="地址、#序号、名称关键字；留空表示 last"/>
                            <Button Style="{StaticResource SubtleButton}" Content="连接目标" Command="{Binding BleConnectCommand}" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding BleStatus}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Haptic / raw02"/>
                            <WrapPanel>
                                <Button Style="{StaticResource SubtleButton}" Content="状态" Command="{Binding HapticStatusCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="Dry-run 开" Command="{Binding DryRunOnCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="Live 关" Command="{Binding LiveOffCommand}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Live 开" Command="{Binding LiveOnCommand}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource SubtleButton}" Content="Tick 实震" Command="{Binding HapticTickCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="Punch 实震" Command="{Binding HapticPunchCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="Stop" Command="{Binding HapticStopCommand}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="安全实震" Command="{Binding SafeHapticTestCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding HapticStatus}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="外部工具"/>
                            <WrapPanel>
                                <Button Style="{StaticResource SubtleButton}" Content="joy.cpl" Command="{Binding OpenJoyCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="设备管理器" Command="{Binding OpenDeviceManagerCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding NextAction}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="模式选择"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource DeviceCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="168"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="158" Height="96" Stretch="Uniform">
                                        <Canvas Width="260" Height="150">
                                            <Path Fill="#F7F9FB" Stroke="#C8D1DA" StrokeThickness="4"
                                                  Data="M45,46 C28,50 20,72 15,98 C11,121 24,136 43,125 L78,106 C88,100 99,101 109,108 C124,118 136,118 151,108 C161,101 172,100 182,106 L217,125 C236,136 249,121 245,98 C240,72 232,50 215,46 C196,42 180,52 166,61 L94,61 C80,52 64,42 45,46 Z"/>
                                            <Path Fill="#111827" Stroke="#111827" StrokeThickness="2"
                                                  Data="M86,54 L174,54 C183,54 190,61 190,70 L190,99 C190,108 183,115 174,115 L86,115 C77,115 70,108 70,99 L70,70 C70,61 77,54 86,54 Z"/>
                                            <Ellipse Fill="#101820" Stroke="#334155" StrokeThickness="3" Width="28" Height="28" Canvas.Left="82" Canvas.Top="75"/>
                                            <Ellipse Fill="#101820" Stroke="#334155" StrokeThickness="3" Width="28" Height="28" Canvas.Left="150" Canvas.Top="75"/>
                                            <Ellipse Fill="#E11D48" Width="11" Height="11" Canvas.Left="203" Canvas.Top="64"/>
                                            <Ellipse Fill="#0F766E" Width="11" Height="11" Canvas.Left="218" Canvas.Top="79"/>
                                            <Ellipse Fill="#F59E0B" Width="11" Height="11" Canvas.Left="203" Canvas.Top="94"/>
                                            <Ellipse Fill="#2563EB" Width="11" Height="11" Canvas.Left="188" Canvas.Top="79"/>
                                            <Rectangle Fill="#334155" Width="32" Height="10" RadiusX="2" RadiusY="2" Canvas.Left="38" Canvas.Top="80"/>
                                            <Rectangle Fill="#334155" Width="10" Height="32" RadiusX="2" RadiusY="2" Canvas.Left="49" Canvas.Top="69"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DualSense 触觉模式" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="PC 识别为 DualSense + 4ch 音频，监听游戏 haptic audio，再转 Pro2 raw02。" Style="{StaticResource HintText}" Margin="0,4,0,10"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="刷入 DualSense 触觉" Command="{Binding FlashHapticCommand}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource DeviceCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="168"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="158" Height="96" Stretch="Uniform">
                                        <Canvas Width="260" Height="150">
                                            <Path Fill="#111827" Stroke="#0F172A" StrokeThickness="4"
                                                  Data="M47,36 C28,38 17,62 14,94 C12,121 28,139 49,128 L82,111 C94,105 103,108 113,117 C128,130 142,130 157,117 C167,108 176,105 188,111 L221,128 C242,139 258,121 256,94 C253,62 242,38 223,36 C202,33 187,47 174,60 L86,60 C73,47 58,33 47,36 Z"/>
                                            <Ellipse Fill="#1F2937" Stroke="#64748B" StrokeThickness="3" Width="34" Height="34" Canvas.Left="78" Canvas.Top="77"/>
                                            <Ellipse Fill="#1F2937" Stroke="#64748B" StrokeThickness="3" Width="34" Height="34" Canvas.Left="148" Canvas.Top="77"/>
                                            <Ellipse Fill="#0F766E" Width="12" Height="12" Canvas.Left="202" Canvas.Top="64"/>
                                            <Ellipse Fill="#94A3B8" Width="12" Height="12" Canvas.Left="219" Canvas.Top="81"/>
                                            <Ellipse Fill="#94A3B8" Width="12" Height="12" Canvas.Left="202" Canvas.Top="98"/>
                                            <Ellipse Fill="#94A3B8" Width="12" Height="12" Canvas.Left="185" Canvas.Top="81"/>
                                            <Rectangle Fill="#94A3B8" Width="34" Height="10" RadiusX="2" RadiusY="2" Canvas.Left="37" Canvas.Top="84"/>
                                            <Rectangle Fill="#94A3B8" Width="10" Height="34" RadiusX="2" RadiusY="2" Canvas.Left="49" Canvas.Top="72"/>
                                            <Ellipse Fill="#64748B" Width="10" Height="10" Canvas.Left="121" Canvas.Top="70"/>
                                            <Ellipse Fill="#64748B" Width="10" Height="10" Canvas.Left="140" Canvas.Top="70"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Pro2 原生模式" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="原生 Switch 2 Pro / Pro2 桥接，保持手柄 report、陀螺仪和普通 raw02 路线。" Style="{StaticResource HintText}" Margin="0,4,0,10"/>
                                        <Button Style="{StaticResource RoseButton}" Content="刷入 Pro2 原生" Command="{Binding FlashPro2Command}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource SubtleButton}" Content="HID 恢复固件" Command="{Binding FlashHidOnlyCommand}"/>
                            <TextBlock Text="{Binding FirmwareSummary}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="游戏监听模式"/>
                                <TextBlock Style="{StaticResource HintText}" Text="用于霍格沃兹、Apex、Metro 等真实游戏。启动后保持 Live raw02，每秒采样 status，最终输出 GAME_MONITOR_RESULT。"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource InputBox}" Width="70" Text="{Binding GameMonitorSeconds}" ToolTip="监听秒数，10..900"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="开始监听" Command="{Binding StartGameMonitorCommand}"/>
                                <Button Style="{StaticResource RoseButton}" Content="停止监听并关闭 Live" Command="{Binding StopGameMonitorCommand}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding MonitorStatus}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="raw02 安全状态"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding SafetySummary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="音频 Pattern 自测"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AudioPatterns}" SelectedItem="{Binding AudioPattern}" Margin="0,0,6,0" Padding="7,5"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding AudioIntensity}" Margin="0,0,6,0" ToolTip="0..100"/>
                                <TextBox Grid.Column="2" Style="{StaticResource InputBox}" Text="{Binding AudioDurationMs}" Margin="0,0,6,0" ToolTip="milliseconds"/>
                                <TextBox Grid.Column="3" Style="{StaticResource InputBox}" Text="{Binding AudioDeviceName}" Margin="0,0,6,0" ToolTip="Device name substring"/>
                                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="发送实震" Command="{Binding SendAudioPatternCommand}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="下一步"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding NextAction}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="日志"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,8,8" ToolTip="串口命令，例如 status / haptic status"/>
                            <WrapPanel Grid.Column="2">
                                <Button Style="{StaticResource SubtleButton}" Content="发送" Command="{Binding SendCustomCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="清空" Command="{Binding ClearLogCommand}"/>
                                <Button Style="{StaticResource SubtleButton}" Content="保存" Command="{Binding SaveLogCommand}"/>
                            </WrapPanel>
                        </Grid>
                        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="#0C1117" Foreground="#DCE7EE" BorderThickness="0" Padding="10"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
