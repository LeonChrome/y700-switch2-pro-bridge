<Window x:Class="Y700Switch2Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Y700 Switch 2 ESP32-S3 Manager" Height="760" Width="1120"
        MinHeight="620" MinWidth="920">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#20242b" Padding="12">
            <StackPanel>
                <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="Y700 Switch 2 ESP32-S3 Manager"/>
                <TextBlock Foreground="#c6ccd6" Text="PENDING_HARDWARE_TEST: this manager is a control shell only; hardware flash, USB HID enumeration, Steam recognition, and BLE behavior are not verified yet."/>
            </StackPanel>
        </Border>

        <TabControl Margin="10">
            <TabItem Header="Dashboard">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Status"/>
                        <TextBlock Text="{Binding ConnectionStatus}"/>
                        <TextBlock Text="{Binding SelectedPort, StringFormat=Port: {0}}"/>
                        <TextBlock Text="{Binding FirmwareVersion, StringFormat=Firmware: {0}}"/>
                        <TextBlock Text="{Binding DeviceMode, StringFormat=Mode: {0}}"/>
                        <TextBlock Text="{Binding UsbStatus, StringFormat=USB HID: {0}}"/>
                        <TextBlock Text="{Binding BleStatus, StringFormat=BLE: {0}}"/>
                        <TextBlock Text="{Binding HidStatus, StringFormat=HID: {0}}"/>
                    </StackPanel>
                    <GroupBox Grid.Column="1" Header="Latest Device Message">
                        <TextBox Text="{Binding LastDeviceMessage}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Device">
                <StackPanel Margin="10">
                    <TextBlock Text="CH343P Type-C is expected for flashing, logs, and serial control. Native ESP32-S3 USB &amp; OTG Type-C is expected for HID tests." TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8">
                        <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"/>
                        <Button Content="Refresh" Command="{Binding RefreshPortsCommand}"/>
                        <Button Content="Connect" Command="{Binding ConnectCommand}"/>
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
                        <Button Content="Status" Command="{Binding StatusCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding Ports}" Height="260"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Control">
                <StackPanel Margin="10">
                    <WrapPanel>
                        <Button Content="Start bridge" Command="{Binding StartCommand}"/>
                        <Button Content="Stop bridge" Command="{Binding StopCommand}"/>
                        <Button Content="Reboot device" Command="{Binding RebootCommand}"/>
                        <Button Content="Generic HID Mode" Command="{Binding ModeGenericCommand}"/>
                        <Button Content="Nintendo Experiment Mode" Command="{Binding ModeNintendoCommand}"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="Send test A button" Command="{Binding HidTestACommand}"/>
                        <Button Content="Neutral report" Command="{Binding HidNeutralCommand}"/>
                        <Button Content="BLE scan" Command="{Binding BleScanCommand}"/>
                        <Button Content="BLE disconnect" Command="{Binding BleDisconnectCommand}"/>
                    </WrapPanel>
                    <GroupBox Header="Command JSON">
                        <TextBox Text="{Binding LastCommandJson}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="220"/>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Logs">
                <DockPanel Margin="10">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Clear" Command="{Binding ClearLogsCommand}"/>
                        <Button Content="Save txt" Command="{Binding SaveLogsCommand}"/>
                        <Button Content="Copy" Command="{Binding CopyLogsCommand}"/>
                        <CheckBox Content="Auto scroll" IsChecked="{Binding AutoScroll}" Margin="12,8"/>
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <ComboBox SelectedItem="{Binding LogFilter}">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="USB"/>
                            <ComboBoxItem Content="HID"/>
                            <ComboBoxItem Content="BLE"/>
                            <ComboBoxItem Content="ERROR"/>
                            <ComboBoxItem Content="Steam"/>
                            <ComboBoxItem Content="MODE"/>
                            <ComboBoxItem Content="JSON"/>
                        </ComboBox>
                    </WrapPanel>
                    <TextBox Text="{Binding FilteredLogText}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Flash">
                <StackPanel Margin="10">
                    <TextBlock FontWeight="SemiBold" Text="PENDING_HARDWARE_TEST"/>
                    <TextBlock Text="Flash/logging: connect CH343P Type-C. HID tests: connect ESP32-S3 native USB &amp; OTG Type-C." TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding FirmwareDirectory, StringFormat=Firmware directory: {0}}" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"/>
                        <Button Content="Build" Command="{Binding BuildFirmwareCommand}"/>
                        <Button Content="Flash" Command="{Binding FlashFirmwareCommand}"/>
                        <Button Content="Monitor" Command="{Binding MonitorCommand}"/>
                    </WrapPanel>
                    <TextBox Text="{Binding ScriptOutput}" IsReadOnly="True" FontFamily="Consolas" Height="420" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Recognition">
                <StackPanel Margin="10">
                    <TextBlock Text="Record VID, PID, product string, manufacturer string, If_Hid visibility, and whether Steam enters a Nintendo/Switch controller path." TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="Open joy.cpl" Command="{Binding OpenJoyCommand}"/>
                        <Button Content="Open Device Manager" Command="{Binding OpenDeviceManagerCommand}"/>
                        <Button Content="Open Steam log folder" Command="{Binding OpenSteamLogsCommand}"/>
                        <Button Content="Copy test checklist" Command="{Binding CopyChecklistCommand}"/>
                    </WrapPanel>
                    <TextBox Text="{Binding RecognitionChecklist}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="10">
                    <CheckBox Content="Auto connect last COM port" IsChecked="{Binding Settings.AutoConnectLastPort}"/>
                    <CheckBox Content="Start with Windows (UI placeholder)" IsChecked="{Binding Settings.StartWithWindows}"/>
                    <CheckBox Content="Minimize to tray (UI placeholder)" IsChecked="{Binding Settings.MinimizeToTray}"/>
                    <WrapPanel>
                        <TextBlock Text="Default mode:" VerticalAlignment="Center"/>
                        <ComboBox SelectedItem="{Binding Settings.DefaultMode}">
                            <ComboBoxItem Content="generic"/>
                            <ComboBoxItem Content="nintendo"/>
                        </ComboBox>
                        <TextBlock Text="Log level:" VerticalAlignment="Center"/>
                        <ComboBox SelectedItem="{Binding Settings.LogLevel}">
                            <ComboBoxItem Content="info"/>
                            <ComboBoxItem Content="debug"/>
                        </ComboBox>
                    </WrapPanel>
                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="About">
                <StackPanel Margin="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Y700 Switch 2 ESP32-S3 Manager"/>
                    <TextBlock Text="Version 0.1.0"/>
                    <TextBlock Text="GitHub: https://github.com/LeonChrome/y700-switch2-pro-bridge"/>
                    <TextBlock Text="Credit: inspired by switch2-controller-windows10-dual-layouts and the existing Y700 bridge work." TextWrapping="Wrap"/>
                    <TextBlock Text="This project is not affiliated with, endorsed by, or sponsored by Nintendo." TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="This tool is intended for personal input-device compatibility research." TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
